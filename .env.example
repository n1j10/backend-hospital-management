NODE_ENV=development
PORT=5000

# Postgres (Neon) connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/hospital_management"

# JWT — use a long random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-64-char-random-string
JWT_EXPIRES_IN=7d

# S3-compatible object storage (Neon storage / AWS S3 / R2)
AWS_ENDPOINT_URL_S3=https://your-endpoint
AWS_REGION=us-east-1
AWS_BUCKET=default-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Comma-separated frontend origins allowed by CORS (empty = any origin)
CORS_ORIGIN=
# Set to "false" once staff accounts exist: only an ADMIN should create users after that
ALLOW_SELF_REGISTRATION=true
