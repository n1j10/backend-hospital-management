NODE_ENV=development
PORT=5000

# Postgres connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/hospital_management"

# JWT
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

# S3-compatible object storage (required: the app will not start without these)
AWS_ENDPOINT_URL_S3=https://your-s3-endpoint
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_BUCKET=default-bucket
